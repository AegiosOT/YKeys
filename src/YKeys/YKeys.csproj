<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ykeys</AssemblyName>
    <RootNamespace>YKeys</RootNamespace>
    <AssemblyTitle>YKeys hotkey daemon</AssemblyTitle>
    <!-- Hotkey-to-action latency is the product; AOT is mandatory. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <InternalsVisibleTo Include="YKeys.Tests" />
  </ItemGroup>

</Project>
